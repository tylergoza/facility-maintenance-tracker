# /etc/caddy/sites/maintenance-tracker.caddy, managed by the maintenance tracker's
# deploy/ansible; edits here are overwritten on the next deploy.
{{ app_domain }} {
	# /events streams live updates; compressing it would hold them back.
	@compress not path /events
	encode @compress gzip
	reverse_proxy {{ hostvars[groups['app'][0]].private_ip }}:{{ app_port }}
}
